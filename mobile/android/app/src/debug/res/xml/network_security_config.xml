<?xml version="1.0" encoding="utf-8"?>
<!--
  S-M6 — FAQAT debug variant. Bu fayl release APK/AAB ga KIRMAYDI
  (src/debug/ manba to'plami faqat debug build'da qo'llanadi).
  Maqsad: dev muhitida lokal backend (http://10.0.2.2:8080, emulator host loopback).
  Prod/stage domenlariga cleartext bu yerda ham ochilmaydi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Debug'da MITM proxy (Charles/mitmproxy) bilan tarmoqni ko'rish uchun. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
