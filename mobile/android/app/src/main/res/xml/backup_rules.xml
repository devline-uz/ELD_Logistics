<?xml version="1.0" encoding="utf-8"?>
<!--
  S-H4 / MASVS-STORAGE-8 — Android 11 va pastroq (fullBackupContent).
  `android:allowBackup="false"` bilan birga ishlatiladi: hech qanday ilova ma'lumoti
  Google Drive Auto Backup'ga chiqmaydi. Bu yerda saqlanadigan narsalar:
  Drift/SQLCipher DB, imzo PNG lari, DVIR fotolari, outbox va secure storage —
  barchasi HOS yozuvi (FMCSA) va PII (§17.1).
  Ro'yxat ATAYIN faqat `<exclude>` dan iborat: yangi papka qo'shilsa ham backup'ga tushmaydi.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
