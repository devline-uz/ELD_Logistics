<?xml version="1.0" encoding="utf-8"?>
<!--
  S-H4 / MASVS-STORAGE-8 — Android 12+ (API 31+).
  `cloud-backup` — Google Drive'ga zaxira; `device-transfer` — qurilmadan qurilmaga ko'chirish.
  Ikkalasi ham to'liq bloklanadi: SQLCipher DB, imzo PNG, DVIR fotolari,
  EncryptedSharedPreferences (refresh token, PIN hash, device_id) ko'chirilmaydi.
  Kalit Keystore'da qoladi — ko'chirilgan ma'lumot baribir ochilmasdi, lekin
  shifrlangan blob'ni ham chiqarmaymiz.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
