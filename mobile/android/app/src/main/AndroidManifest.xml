<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================= ELD / BLE (tz-mobile §10.2, skill flutter-ble §3) =========
         Android 12+ (API 31): BLUETOOTH_SCAN da `neverForLocation` **QO'YILMAYDI** —
         skan natijasi joylashuv aniqlashda ishlatiladi (FMCSA pozitsiya talabi).
         Android 10/11 (API 29–30) uchun eski BLUETOOTH/BLUETOOTH_ADMIN saqlanadi. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ================= Joylashuv ================================================
         ACCESS_BACKGROUND_LOCATION — Play review 1–3 hafta (risk R1); rad etilsa
         ilova faqat foreground rejimida ishlaydi (M69: bloklanmaydi). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ================= Fon xizmati (tz-mobile §10.4, M73) =======================
         Android 14+ (API 34) da foregroundServiceType har biri uchun alohida
         ruxsat talab qiladi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Android 13+ fon xizmati va push bildirishnomalari uchun. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ============ S-M5: OLIB TASHLANGAN RUXSATLAR (Play siyosati) ============
         Quyidagilar hozir kodda ishlatilmaydi, shuning uchun manifestdan chiqarildi.
         Play Console ortiqcha ruxsat uchun deklaratsiya so'raydi yoki rad etadi.

         RECEIVE_BOOT_COMPLETED   — boot receiver e'lon qilinmagan. B-46 (lokal
             bildirishnomalar / `flutter_local_notifications`) qo'shilganda, agar
             rejalashtirilgan bildirishnoma qayta yuklashdan keyin ham tirik
             qolishi kerak bo'lsa, ruxsat + `ScheduledNotificationBootReceiver`
             receiver'i BIRGA qaytariladi. Receiver'siz ruxsat qaytmaydi.
             ESLATMA: birlashtirilgan manifestda bu ruxsat baribir bor — uni
             `flutter_foreground_task` o'z `RebootReceiver` i bilan e'lon qiladi
             (fon xizmatini qayta yuklashdan keyin tiklash uchun). Ya'ni ruxsat
             haqiqiy receiver bilan asoslangan; biz uni takrorlamaymiz.

         SCHEDULE_EXACT_ALARM     — M60 idle prompt aniq vaqtda kerak bo'lsa,
             B-46 da `USE_EXACT_ALARM` emas, aynan `SCHEDULE_EXACT_ALARM`
             qaytariladi (Play "Exact alarm" deklaratsiyasi bilan; ELD uchun
             asosnoma: haydovchini HOS buzilishidan oldin ogohlantirish).
             Agar `zonedSchedule(..., inexactAllowWhileIdle)` yetarli bo'lsa —
             ruxsat umuman qaytmaydi (afzal yo'l).

         USE_FULL_SCREEN_INTENT   — faqat to'liq ekranli, tovushli signal kerak
             bo'lsa (masalan 30-daqiqalik tanaffus muddati) qaytariladi;
             Android 14+ da Play deklaratsiyasi majburiy. Hozir bunday UX yo'q.
         ======================================================================== -->

    <!-- Doze istisnosi — tushuntirish dialogi bilan so'raladi (§10.4). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- BLE qurilmasiz telefonlarda ilova o'rnatilmaydi (ELD talabi). -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="eld_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- S-H4 (MASVS-STORAGE-8): allowBackup="false" + backup_rules (API ≤30) +
             data_extraction_rules (API 31+). SQLCipher DB, imzo PNG lari, DVIR
             fotolari va EncryptedSharedPreferences Google Drive'ga yoki yangi
             qurilmaga KO'CHIRILMAYDI.
             S-M6 (§17.7): cleartext butunlay taqiq; debug variantda
             `src/debug/res/xml/network_security_config.xml` faqat 10.0.2.2 /
             localhost uchun istisno beradi (release AAB ga kirmaydi). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- M162: faqat `onebookeld://` sxemasi va `eld.stackyard.uz` hosti. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="onebookeld" />
            </intent-filter>
            <!-- #B-132: App Links — `https://eld.stackyard.uz/...` ilovada ochiladi.
                 `autoVerify="true"` uchun serverda
                 `/.well-known/assetlinks.json` (release imzo SHA-256 bilan) bo'lishi
                 SHART — RELEASE.md §3.2. Fayl qo'yilmaguncha link brauzerda ochiladi
                 (xavfsiz zaxira yo'l), ilova ishlashi buzilmaydi.
                 Host oq ro'yxati Dart tomonida ham tekshiriladi
                 (`notification_deeplink.dart`, M162). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="eld.stackyard.uz" />
            </intent-filter>
        </activity>

        <!-- ============ ELD foreground service (tz-mobile §10.4, M73) =============
             `flutter_foreground_task` xizmatini `location|connectedDevice` turi
             bilan qayta e'lon qilamiz (kutubxona manifestidagi turni almashtirish
             uchun `tools:replace` shart). Bildirishnoma `ongoing` — foydalanuvchi
             surib o'chira olmaydi; xizmat haydash rejimida to'xtatilmaydi. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location|connectedDevice" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
