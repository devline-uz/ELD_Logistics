# ---------------------------------------------------------------------------
# ONEBOOK ELD backend — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
APP_ENV=local                       # local | dev | staging | prod
REGION=us-east-1
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=debug                     # debug | info | warn | error
SENTRY_DSN=

# Datastores
DATABASE_URL=postgres://eld:eld@localhost:5432/onebook_eld?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security — JWT_SECRET >= 32 bytes, ENCRYPTION_KEY exactly 32 bytes (AES-256)
JWT_SECRET=dev-jwt-secret-change-me-0123456789abc
ENCRYPTION_KEY=dev-encryption-key-32-bytes-xxxx

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DRIVER=720h             # 30 days — mobile / driver sessions
REFRESH_TTL_ADMIN=168h              # 7 days — web / admin sessions

# CORS — comma separated allowlist (required outside local)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Object storage (S3 compatible: MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=onebook-eld
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL=

# Infrastructure surfaces — /metrics and /api/docs.
# In staging/prod each one must be either disabled or guarded: the process
# refuses to start otherwise. Locally both stay open.
METRICS_ENABLED=true
METRICS_TOKEN=                      # bearer token for GET /metrics
METRICS_ALLOW_CIDR=                 # e.g. 10.0.0.0/8,192.168.1.10 (skips the token)
DOCS_ENABLED=true
DOCS_TOKEN=                         # bearer token for /api/docs/*
DOCS_ALLOW_CIDR=

# Rate limiting (Redis backed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SYNC=60
RATE_LIMIT_BURST=20
RATE_LIMIT_TRUSTED_CIDR=

# WebSocket (/api/v1/ws) — realtime transport
WS_ENABLED=true
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173   # empty = same-origin only, "*" = dev
WS_PING_PERIOD=30s                  # server keepalive interval
WS_PONG_WAIT=65s                    # drop after two missed pings + grace

# Map provider (TZ B§7.3) — reverse geocoding for the FMCSA location text
# (Q9) and trip planner directions (Q66.1). Without a working provider the
# process still starts: it falls back to the nop provider (empty location
# text, no route geometry) with one warning.
GEO_PROVIDER=nominatim               # nominatim | photon | google | nop
GEO_GEOCODE_URL=                     # self hosted Nominatim/Photon base URL
GEO_ROUTING_URL=                     # self hosted OSRM base URL (directions)
GEO_API_KEY=                         # Google Maps Platform key (provider=google)
GEO_REGION=us                        # biases the Google geocoder
GEO_USER_AGENT=onebook-eld/1.0       # required by the Nominatim usage policy
GEO_CACHE_GRID_M=100                 # reverse geocode cache cell size, metres

# Notifications — every provider is optional. A missing credential disables
# that channel with a warning; the in-app inbox is always written.
# Push — Firebase Cloud Messaging (Android + web)
NOTIFY_FCM_PROJECT_ID=
NOTIFY_FCM_SERVICE_ACCOUNT_FILE=    # path to the service account JSON key
NOTIFY_FCM_SERVICE_ACCOUNT_JSON=    # or the key inline (secret manager)
# Push — Apple Push Notification service
NOTIFY_APNS_AUTH_KEY_FILE=          # path to the .p8 provider key
NOTIFY_APNS_AUTH_KEY=               # or the key inline
NOTIFY_APNS_KEY_ID=
NOTIFY_APNS_TEAM_ID=
NOTIFY_APNS_TOPIC=                  # iOS bundle id
NOTIFY_APNS_PRODUCTION=false
# Email
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_STARTTLS=true
# SMS — generic HTTP gateway
NOTIFY_SMS_ENDPOINT=
NOTIFY_SMS_TOKEN=
NOTIFY_SMS_TO_FIELD=to
NOTIFY_SMS_TEXT_FIELD=text
# Telegram bot
NOTIFY_TELEGRAM_BOT_TOKEN=
