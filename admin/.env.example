# --- Runtime (bundle'ga tushadi — maxfiy kalit YOZILMAYDI) ---
VITE_API_BASE_URL=https://eldapi.stackyard.uz/api/v1
VITE_WS_URL=wss://eldapi.stackyard.uz/api/v1/ws

# MapLibre style JSON URL.
# Q1 YOPILDI: provayder — MapTiler Cloud (MVP). Chiqish yo'li: Protomaps/PMTiles self-hosting.
# Qaror va asos: docs/tz/16-17-registry-open-questions.md -> D-Q1
#
# Kalit URL ichida keladi, shuning uchun MapTiler panelida u DOMEN BO'YICHA
# CHEKLANGAN bo'lishi SHART (eldadmin.stackyard.uz + dev uchun localhost) — F9.
# Style oilasi: kam kontrastli basic/dataviz (satellite yoki streets EMAS) —
# 500 ta duty-status markeri ustidan o'qilishi kerak.
#
# Namuna: https://api.maptiler.com/maps/basic-v2/style.json?key=<DOMEN-CHEKLANGAN-KALIT>
VITE_MAP_STYLE_URL=

# Fayl saqlash (DVIR fotolari/imzolari, invoice) — F111, fe-security §12.
# VITE_FILES_BASE_URL — kalitni ko'rish URL'iga aylantirish uchun baza (https).
#   Bo'sh bo'lsa UI rasm o'rniga kalitni matn sifatida ko'rsatadi.
# VITE_FILES_UPLOAD_HOST — presign `upload_url` uchun HOST OQ RO'YXATI
#   (vergul bilan). Bo'sh bo'lsa faqat sxema/metod tekshiriladi va buzilgan
#   presign javobi faylni ixtiyoriy hostga jo'nata oladi — PROD'da TO'LDIRILSIN.
VITE_FILES_BASE_URL=
VITE_FILES_UPLOAD_HOST=

# Sentry (xato monitoringi) — IXTIYORIY, 9.12.
# Bo'sh bo'lsa `@sentry/react` chunk'i umuman yuklanmaydi va ilova
# o'zgarishsiz ishlaydi. To'ldirilsa: PII filtri (`src/lib/sentry.scrub.ts`)
# Authorization header'i, token, parol, `license_no`, ism/telefon/emailni
# `••••••` bilan almashtiradi (F206).
# ⚠️ DSN hosti CSP `connect-src` ga qo'shilishi SHART — docs/deploy.md §5.
VITE_SENTRY_DSN=

# MSW (Mock Service Worker) — dev serverni mock backend bilan ko'tarish (9.1).
# `1` bo'lsa `src/main.tsx` `src/mocks/browser.ts` ni dinamik import qiladi va
# `setupWorker` ishga tushadi — haqiqiy tarmoqqa so'rov ketmaydi (F226).
# Faqat `import.meta.env.DEV` bilan birga ishlaydi, prod bundle'ga TUSHMAYDI.
# Playwright e2e `playwright.config.ts` `webServer` orqali avtomatik o'rnatadi.
VITE_ENABLE_MSW=

# --- Faqat ishlab chiqish vaqti (bundle'ga TUSHMAYDI) ---
# Swagger docs endpointi va uning bearer tokeni — `npm run api` uchun.
# `GET /api/docs/swagger.json` tokensiz 401 UNAUTHORIZED qaytaradi.
VITE_API_DOCS_URL=https://eldapi.stackyard.uz/api/docs
DOCS_TOKEN=

# Sentry release + sourcemap yuklash (`@sentry/vite-plugin`). Faqat CI
# secret sifatida beriladi; `VITE_` prefiksi YO'Q, shuning uchun bundle'ga
# TUSHMAYDI. Bo'sh bo'lsa plagin build'ga umuman ulanmaydi.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
