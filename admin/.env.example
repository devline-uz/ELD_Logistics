# MapLibre style JSON. Provayder hali tasdiqlanmagan (§17 Q1 — MapTiler yoki self-host Protomaps).
# Tile kaliti domen bo'yicha cheklangan bo'lishi SHART.
VITE_MAP_STYLE_URL=

# Ixtiyoriy
